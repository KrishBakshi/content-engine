# content-engine: one fetch + retention cleanup per start. Triggered by content-engine.timer.
# Generated from deploy/templates/content-engine.service.template by deploy/render.py.
[Unit]
Description=content-engine: fetch tech & AI news, then delete data older than @@RETENTION_DAYS@@ days
Documentation=file://@@INSTALL_DIR@@/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@@RUN_USER@@
Group=@@RUN_USER@@
WorkingDirectory=@@INSTALL_DIR@@
Environment=CONTENT_ENGINE_DATA_DIR=@@DATA_DIR@@
Environment=CONTENT_ENGINE_RETENTION_DAYS=@@RETENTION_DAYS@@
ExecStart=@@BIN@@ run
# 75 = another run still holds the lock; the next tick will run, so it is not a failure.
SuccessExitStatus=75
TimeoutStartSec=10min
@@STATE_DIRECTORY_BLOCK@@

# Hardening: the engine only needs outbound HTTPS and write access to its data dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=@@DATA_DIR@@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
